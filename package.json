{
  "name": "rtl-architect",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.1",
    "npm": "11.6.2"
  },
  "scripts": {
    "arch": "./bin/rtlarch",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "check": "node --import tsx scripts/check.ts",
    "rtl:test": "node --import tsx scripts/check.ts rtl",
    "benchmark:external-axis": "node --import tsx scripts/benchmarks/axis-register.ts",
    "benchmark:axis-fifo": "python3 -B scripts/benchmarks/axis-fifo.py",
    "check:browser": "node scripts/benchmarks/browser.mjs",
    "release": "node --import tsx scripts/release.ts"
  },
  "dependencies": {
    "@xyflow/react": "12.10.0",
    "elkjs": "0.11.0",
    "express": "5.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  },
  "packageManager": "npm@11.6.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jayden-Cai-nbb/rtl-architect.git"
  }
}
