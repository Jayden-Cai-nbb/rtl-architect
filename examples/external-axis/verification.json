        "vendor/axis_register.v",
        "rtl/axis_pair.sv",
        "tb.sv"
      ]
    },
    {
      "program": "{runDir}/obj/Vtb",
      "args": []
    }
  ],
  "checks": [
    {
      "kind": "contains",
      "file": "step-1.stdout.log",
