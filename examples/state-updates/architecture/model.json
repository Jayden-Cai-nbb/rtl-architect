      "contract": {
        "responsibility": "单级弹性输出寄存器，实现 (x + CONST) mod 2^DATA_W。",
        "latencyMinCycles": 1,
        "latencyCondition": "输入握手采样边沿至对应输出握手采样边沿；初始为空、无复位且下游持续 ready 时为最小延迟。持续背压不声明有限最大延迟。稳定无背压目标每周期 1 个事务。",
        "backpressure": "发送方在 valid && !ready 时保持 valid/data，直到接收或复位。加法级 s_ready = rst_n && (!out_valid || m_ready)，允许输出接收同沿装入新结果。",
        "resetBehavior": "posedge clk 同步低有效 rst_n，清空 out_data/out_valid；组合 valid/ready 在复位期间为 0。",
        "invariants": [
          "仅在 posedge clk 且 rst_n=1 时以 valid && ready 记账。",
          "每个未被复位取消的输入恰好按序输出一次。",
          "DATA_W 为 1..32，CONST 为 0..2^DATA_W-1；结果按 DATA_W 截断。"
        ],
        "verificationPlan": [
          "逐状态检查复位、装载和保持，所有声明分支均须被实际触发。",
          "单独核对接口吞吐和背压合同；状态监视器不证明完整协议或形式等价。"
        ],
