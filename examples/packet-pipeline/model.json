{
  "schemaVersion": 2,
  "design": {
    "id": "packet_pipeline",
    "name": "128-bit Packet Pipeline",
    "top": "packet_top"
  },
  "clocks": [
    {
      "id": "clk",
      "edge": "rising"
    }
  ],
  "resets": [
    {
      "id": "rst_n",
      "clock": "clk",
      "activeLevel": "low",
      "synchronous": true
    }
  ],
  "modules": [
    {
      "id": "packet_top",
      "name": "Packet Pipeline",
      "parent": null,
      "kind": "subsystem",
      "rtlModule": "packet_top",
      "clock": "clk",
      "reset": "rst_n",
      "parameters": {
        "DATA_W": 128
      },
      "interfaces": [
        {
          "id": "rx",
          "role": "consumer",
          "protocol": "rv",
          "width": {
            "param": "DATA_W"
          },
          "required": true
        },
        {
          "id": "tx",
          "role": "producer",
          "protocol": "rv",
          "width": {
            "param": "DATA_W"
          },
          "required": true
        }
      ],
      "contract": {
        "responsibility": "接收 128 位无符号载荷，通过入口、处理子系统与出口保持原始数据和事务顺序。",
        "latencyMinCycles": 5,
        "latencyCondition": "初始为空、无复位且下游持续 ready；不声明持续背压下的有限最大延迟。稳定运行目标每周期 1 个事务。",
        "backpressure": "valid && !ready 时保持 valid 和 data，直到握手或复位。只有 valid && ready 才接收事务。",
        "resetBehavior": "clk 上升沿采样同步低有效 rst_n；清空在途事务；复位期间 valid/ready 输出为 0。",
        "invariants": [
          "保持接收顺序，不重复或丢失未被复位取消的事务。",
          "任何时刻内部占用计数不超过配置的容量。"
        ],
        "verificationPlan": [
          "按输入输出握手维护 scoreboard，覆盖连续流量与随机背压。",
          "覆盖在途复位、满/空边界、输入暂停与输出恢复。"
        ],
        "openQuestions": []
      }
    },
    {
