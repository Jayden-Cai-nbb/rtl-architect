  "specification": {
    "summary": "一个用于展示 AI 架构提案、分层框图和逐模块审阅的 128 位数据流处理流水线。当前计算语义为透传，无对应行为 RTL；实现前须完成审阅并导出合同。",
    "requirements": [
      {
        "id": "REQ_ORDER",
        "text": "所有未被复位取消的输入按序输出，载荷不变。",
        "moduleIds": [
          "packet_top",
          "processing",
          "compute"
        ],
        "acceptance": "随机背压和连续输入下，scoreboard 无丢失、重复或数据错误。"
      },
      {
        "id": "REQ_BUFFER",
        "text": "缓冲容量最多 16 个载荷，满时不接收新事务。",
        "moduleIds": [
          "buffer"
        ],
        "acceptance": "覆盖满/空、指针回绕、同时读写，占用数始终在 0..16。"
      },
      {
        "id": "REQ_RESET",
        "text": "复位采样边沿取消全部在途事务。",
        "moduleIds": [
          "packet_top",
          "ingress",
          "scheduler",
          "buffer",
          "compute",
          "egress"
        ],
        "acceptance": "在多个占用水平下复位，输出不得出现复位前遗留事务。"
      }
    ],
    "decisions": [
      {
        "id": "DEC_RV",
        "text": "以逻辑 rv 通道表示数据流",
        "moduleIds": [
          "packet_top",
          "processing"
        ],
        "rationale": "顶层只画一个连接点；接口详情说明 data/valid 正向、ready 反向。避免单独展示信号线造成拥挤。"
      },
      {
        "id": "DEC_HIERARCHY",
        "text": "将处理路径划为独立子系统",
        "moduleIds": [
          "processing"
        ],
        "rationale": "顶层审阅职责和连接，进入子系统后再确认调度、缓冲与计算细节。"
      }
    ],
    "openQuestions": []
  }
}
