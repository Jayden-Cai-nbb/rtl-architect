      "evidenceIds": [
        "upstream"
      ]
    }
  ],
  "connectionIds": [
    "stage0_data_q",
    "stage0_valid_q",
    "stage0_ready_q",
    "stage1_data_q",
    "stage1_valid_q",
    "stage1_ready_q",
    "boundary_s_axis_tdata",
    "boundary_s_axis_tvalid",
    "boundary_s_axis_tready",
    "boundary_m_axis_tdata",
    "boundary_m_axis_tvalid",
    "boundary_m_axis_tready",
    "stage0_clk",
    "stage1_clk",
