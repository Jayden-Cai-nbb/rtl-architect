        "localSignalId": "stage0_valid_q"
      },
      "loadBranch": "load",
      "evidenceIds": [
        "upstream"
      ]
    },
    {
      "dataState": {
        "moduleId": "stage1",
        "localSignalId": "stage1_data_q"
      },
      "validState": {
        "moduleId": "stage1",
        "localSignalId": "stage1_valid_q"
      },
